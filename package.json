{
  "name": "@dayz-server-manager/source",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "docs:sync": "tsx scripts/sync-static-content.ts",
    "start": "nx run web:serve",
    "start:web": "nx run web:serve",
    "start:server": "nx run server:serve",
    "build": "nx run-many -t build",
    "build:web": "nx run web:build",
    "build:server": "nx run server:build",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:web": "nx run web:typecheck",
    "typecheck:server": "nx run server:typecheck",
    "typecheck:ui": "nx run ui:typecheck",
    "typecheck:database": "nx run database:typecheck",
    "typecheck:client": "nx run api-client:typecheck",
    "typecheck:contracts": "nx run api-contracts:typecheck",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored",
    "lint:fix": "eslint . --max-warnings 0 --no-warn-ignored --fix",
    "lint:web": "nx run web:lint",
    "lint:server": "nx run server:lint",
    "lint:ui": "nx run ui:lint",
    "lint:database": "nx run database:lint",
    "lint:client": "nx run api-client:lint",
    "lint:contracts": "nx run api-contracts:lint",
    "lint:staged": "lint-staged",
    "check:cycles": "madge --circular --extensions ts,tsx apps/ libs/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many -t test",
    "test:web": "nx run web:test",
    "test:server": "nx run server:test",
    "test:ui": "nx run ui:test",
    "test:database": "nx run database:test",
    "test:client": "nx run api-client:test",
    "test:contracts": "nx run api-contracts:test",
    "test:coverage": "nx run-many -t test:coverage",
    "test:web:coverage": "nx run web:test:coverage",
    "test:server:coverage": "nx run server:test:coverage",
    "test:ui:coverage": "nx run ui:test:coverage",
    "test:database:coverage": "nx run database:test:coverage",
    "test:client:coverage": "nx run api-client:test:coverage",
    "test:contracts:coverage": "nx run api-contracts:test:coverage",
    "storybook": "nx run ui:storybook",
    "build-storybook": "nx run ui:build-storybook",
    "graph": "nx graph"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@nx/eslint": "24.0.3",
    "@nx/eslint-plugin": "24.0.3",
    "@nx/js": "24.0.3",
    "@nx/react": "24.0.3",
    "@nx/vite": "24.0.3",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.6",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "17.6.0",
    "madge": "8.0.0",
    "nx": "24.0.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@hookform/resolvers": "7.0.0",
    "better-sqlite3": "11.8.1",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "i18next": "^26.7.1",
    "lucide-react": "1.66.0",
    "marked": "^15.0.12",
    "react-day-picker": "10.0.2",
    "react-hook-form": "7.91.0",
    "react-hot-toast": "2.6.1",
    "react-i18next": "^17.1.12"
  }
}
