{
  "name": "@dayz-server-manager/source",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start": "nx run web:serve",
    "build": "nx run-many -t build",
    "build:web": "nx run web:build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored",
    "lint:fix": "eslint . --max-warnings 0 --no-warn-ignored --fix",
    "lint:staged": "lint-staged",
    "check:cycles": "madge --circular --extensions ts,tsx apps/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many -t test",
    "test:ui": "nx run ui:test",
    "test:coverage": "nx run ui:test:coverage",
    "storybook": "nx run ui:storybook",
    "build-storybook": "nx run ui:build-storybook",
    "graph": "nx graph"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/react": "23.3.0",
    "@nx/vite": "23.3.0",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "15.2.10",
    "lucide-react": "1.59.0",
    "madge": "8.0.0",
    "msw": "2.15.0",
    "nx": "23.3.0",
    "prettier": "3.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "8.6.14",
    "tailwindcss": "4.3.3",
    "typescript": "5.5.4",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "^5.0.5",
    "zod": "3.23.8",
    "zustand": "5.0.15"
  },
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "react-day-picker": "10.0.2",
    "react-hook-form": "7.90.0",
    "react-hot-toast": "2.6.1"
  }
}
