{
  "name": "@dayz-server-manager/source",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start": "nx run web:serve",
    "build": "nx run-many -t build",
    "build:web": "nx run web:build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored",
    "lint:fix": "eslint . --max-warnings 0 --no-warn-ignored --fix",
    "lint:staged": "lint-staged",
    "check:cycles": "madge --circular --extensions ts,tsx apps/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many -t test",
    "test:ui": "nx run ui:test",
    "test:coverage": "nx run ui:test:coverage",
    "storybook": "nx run ui:storybook",
    "build-storybook": "nx run ui:build-storybook",
    "graph": "nx graph"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@nx/eslint": "24.0.1",
    "@nx/eslint-plugin": "24.0.1",
    "@nx/js": "24.0.1",
    "@nx/react": "24.0.1",
    "@nx/vite": "24.0.1",
    "@storybook/addon-a11y": "9.1.21",
    "@storybook/addon-docs": "9.1.21",
    "@storybook/react": "9.1.21",
    "@storybook/react-vite": "9.1.21",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "17.6.0",
    "lucide-react": "1.61.0",
    "madge": "8.0.0",
    "msw": "3.0.3",
    "nx": "24.0.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.5.4",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "zod": "4.6.7",
    "zustand": "5.0.16",
    "eslint-plugin-storybook": "9.1.21"
  },
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "react-day-picker": "10.0.2",
    "react-hook-form": "7.91.0",
    "react-hot-toast": "2.6.1"
  }
}
