# ==============================================================================
# DayZ Server Manager (DSM) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local overrides (never committed to git):
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Daemon (Fastify / apps/server)
# ------------------------------------------------------------------------------
# Port the Node.js Fastify daemon listens on
PORT=5000

# Host binding. 0.0.0.0 binds to all interfaces so other machines and containers can reach
# the daemon; 127.0.0.1 is for local only. A non-loopback host logs a warning at start:
# production use needs HTTPS in front of Aegis (a reverse proxy you provide).
HOST=0.0.0.0

# Node execution environment (development | production | test)
NODE_ENV=development

# Allowed CORS origins for browser API requests (comma-separated if multiple)
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Pino logger severity (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Optional. Leave empty and Aegis generates a key once and keeps it in manager-data/.session.key.
# It signs the login tokens. Set it (min 32 chars) only if the data folder is not kept between
# starts, or if you want the key to come from your own secret store.
SESSION_SECRET=

# Off by default. Set it to the address or CIDR list of your reverse proxy (for example
# 127.0.0.1 or 10.0.0.0/8) so Aegis sees the real client address. `true` trusts every hop.
TRUST_PROXY=

# ------------------------------------------------------------------------------
# Frontend Application (React 19 / apps/web)
# ------------------------------------------------------------------------------
# Base API URL. In local dev, leave empty to use Vite's dev proxy (/api -> :5000)
# Set to an explicit origin only if hosting the frontend on a different domain.
VITE_API_URL=

# Application environment tag
VITE_APP_ENV=development
