# ==============================================================================
# DayZ Server Manager (DSM) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local overrides (never committed to git):
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Daemon (Fastify / apps/server)
# ------------------------------------------------------------------------------
# Port the Node.js Fastify daemon listens on
PORT=5000

# Host binding (0.0.0.0 binds to all interfaces; 127.0.0.1 for local only)
HOST=0.0.0.0

# Node execution environment (development | production | test)
NODE_ENV=development

# Allowed CORS origins for browser API requests (comma-separated if multiple)
CORS_ORIGIN=http://localhost:4200

# Pino logger severity (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Cryptographic secret used for signing session cookies and auth tokens (min 32 chars)
SESSION_SECRET=dev-insecure-secret-change-me-in-production-min-32-chars

# ------------------------------------------------------------------------------
# Frontend Application (React 19 / apps/web)
# ------------------------------------------------------------------------------
# Base API URL. In local dev, leave empty to use Vite's dev proxy (/api -> :5000)
# Set to an explicit origin only if hosting the frontend on a different domain.
VITE_API_URL=

# Application environment tag
VITE_APP_ENV=development
