# Set default behavior to normalize all text files to LF
* text=auto eol=lf

# Source code and web assets
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.svg text eol=lf

# Windows command / batch scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.sqlite binary
*.db binary
